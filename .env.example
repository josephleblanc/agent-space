# Agent Space — environment variables
# Copy to `.env` for local development: cp .env.example .env
#
# Browser-safe vars are prefixed with VITE_ and are embedded in the WASM/JS bundle
# at build time (Trunk). Never put secrets in VITE_* variables.
#
# Server-only vars stay in InsForge secrets or your local shell — never commit real values.

# -----------------------------------------------------------------------------
# Server-only — Vapi webhook auth (Track D)
# Private/server key for verifying Vapi webhook requests (vapi-webhook edge fn).
# Set in InsForge secrets for production; export locally for CLI webhook forwarding.
# Do NOT use the public/client key here — that belongs in VITE_PUBLIC_API_KEY below.
# -----------------------------------------------------------------------------
PRIVATE_VAPI_API_KEY=

# Legacy alias — prefer PRIVATE_VAPI_API_KEY. Still read if PRIVATE_VAPI_API_KEY unset.
# VAPI_API_KEY=

# -----------------------------------------------------------------------------
# Server-only — InsForge CLI (Track C)
# Used by `npx @insforge/cli login` and deploy commands. Never expose to the browser.
# -----------------------------------------------------------------------------
INSFORGE_API_KEY=

# -----------------------------------------------------------------------------
# Hackathon default: set NEBIUS_API_KEY in InsForge secrets for live agent brains (preferred over OpenRouter).
# Server-only — Nebius Token Factory (Track E, H)
# OpenAI-compatible LLM API key for agent-chat edge function.
# Preferred when set; agent-chat falls back to OpenRouter when unset.
# InsForge secrets ONLY — never ship to the client or use in VITE_* vars.
# -----------------------------------------------------------------------------
NEBIUS_API_KEY=

# -----------------------------------------------------------------------------
# Server-only — OpenRouter (Track E fallback)
# OpenAI-compatible LLM at https://openrouter.ai/api/v1
# Used by agent-chat when NEBIUS_API_KEY is not set.
# Default model: meta-llama/llama-3.1-70b-instruct
# InsForge secrets ONLY — never ship to the client or use in VITE_* vars.
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Optional — OpenRouter attribution headers (read by functions/_shared/openrouter.ts).
# Sent as HTTP-Referer / X-Title so calls show up under your app in the
# OpenRouter dashboard. Purely cosmetic; leave blank to omit the headers.
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_TITLE=Agent Space

# -----------------------------------------------------------------------------
# Server-only — auto-injected by InsForge at deploy time (functions/_shared/db.ts)
# Deployed edge functions receive these automatically; you do NOT need to set
# them for production. Export locally only if you want the dev server to talk to
# a real InsForge backend instead of the in-memory mock.
#   INSFORGE_BASE_URL   — project API base (falls back to VITE_INSFORGE_URL)
#   ANON_KEY            — anon key (falls back to VITE_INSFORGE_ANON_KEY)
#   SERVICE_ROLE_KEY    — privileged key for server-side writes (tasks/agents/assets)
# -----------------------------------------------------------------------------
# INSFORGE_BASE_URL=
# ANON_KEY=
# SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Local dev only — InsForge edge-function dev server port (dev-server.ts)
# Defaults to 8787 when unset. Only affects `deno task dev`.
# -----------------------------------------------------------------------------
# INSFORGE_DEV_PORT=8787

# -----------------------------------------------------------------------------
# Browser-safe — Vapi public key (Track D)
# The Vapi dashboard "public" / client API key — NOT the private server key above.
# Embedded at build time; safe to expose in the client bundle.
# Find in the Vapi dashboard under API keys (public / client key).
# Deprecated alias: VITE_VAPI_PUBLIC_KEY (still read by write-env.js if unset).
# -----------------------------------------------------------------------------
VITE_PUBLIC_API_KEY=

# -----------------------------------------------------------------------------
# Browser-safe — InsForge project URL (Track B, G)
# Base URL for room-state polling and edge function requests from the browser.
# Example: https://your-project.insforge.app
# -----------------------------------------------------------------------------
VITE_INSFORGE_URL=

# -----------------------------------------------------------------------------
# Browser-safe — InsForge anon key (optional, Track B)
# Only needed if the client calls InsForge directly (e.g. realtime or auth).
# Room-state polling via edge functions typically does not require this.
# -----------------------------------------------------------------------------
# VITE_INSFORGE_ANON_KEY=

{
  "name": "agent-space-web",
  "version": "1.0.0",
  "private": true,
  "description": "Browser shell for Agent Space (Vapi voice + JS bridges)",
  "scripts": {
    "build": "node scripts/write-env.js && npm run build:vapi-sdk",
    "build:vapi-sdk": "esbuild node_modules/@vapi-ai/web/dist/vapi.js --bundle --format=esm --platform=browser --outfile=js/vapi-sdk.js",
    "prebuild": "node scripts/write-env.js"
  },
  "dependencies": {
    "@vapi-ai/web": "^2.5.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
